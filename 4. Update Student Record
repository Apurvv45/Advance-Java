package com.tca;
import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;


public class UpdateStudent {

	public static void main(String[] args) {
		
		Connection con = null ;
		PreparedStatement ps =null;
		
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		
		try {
			
			 Class.forName("org.postgresql.Driver");
			 
			 con=DriverManager.getConnection("jdbc:postgresql://localhost:5432/ajb22","root","root@123");
			 
			 System.out.println("Enter the name : ");
			 String nm=br.readLine();
			 
			 System.out.println("Enter the Roll no Where you Want to update : ");
			 int rn=Integer.parseInt(br.readLine());
			 
			 
			 ps= con.prepareStatement("UPDATE student SET name = ? WHERE rno =? ");
			 ps.setString(1, nm);
			 ps.setInt(2, rn);
			 
			 int rval = ps.executeUpdate();
			 
			 if( rval==0) {
				 System.out.println("Record not found...");
			 }
			 else {
				 System.out.println("Record updated Successfully...");
			 }
			
		}
		catch(Exception e) {
			System.out.println("Problem while Updating the record..");
			
		}
		finally {
			try {
				if(con != null) {
					con.close();
					
				}
				if(ps != null) {
					ps.close();
				}
					
			}
			catch(Exception e) {
				System.out.println("Error while closing the Connection...");
				e.printStackTrace();
				
			}
		}

	}

}
