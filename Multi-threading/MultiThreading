package com.tca;


class Ithread extends Thread{
	
	public void run() {
		try {
			for(int i=0;i<5;i++) {
				System.out.println("INDIA");
				Thread.sleep(1000);
			}
		}
		
		catch(InterruptedException ie) {
			System.out.println("Problem while running program...");
		}
	}
}

public class Demo {
	
	public static void main(String[] args) {
		Ithread t1 = new Ithread();
		t1.start();
		
		
		try {
			for(int i=0;i<5;i++) {
				System.out.println("Main");
				Thread.sleep(1000);
			}
		}
		catch(InterruptedException ie) {
			ie.printStackTrace();
		}

	 }
	}


